#!/bin/sh
# .lefthook/commit-msg — enforce the Task: T-XXX trailer.
# Discipline: 3-digit zero-padded task IDs (T-001, T-012, T-999).
# The trailer must appear in the body (after the first blank line).
set -e
command -v git >/dev/null 2>&1 || { printf 'commit-msg: git not in PATH.\n' >&2; exit 1; }
MSG_FILE="${1:-.git/COMMIT_EDITMSG}"
MSG=$(cat "$MSG_FILE")

TRAILER_COUNT=$(printf '%s\n' "$MSG" | awk '
  BEGIN { in_body = 0; count = 0 }
  in_body == 1 && /^Task: T-[0-9]{3}[[:space:]]*$/ { count++ }
  in_body == 0 && /^[[:space:]]*$/ && NR > 1 { in_body = 1 }
  END { print count + 0 }
')

if [ "$TRAILER_COUNT" -eq 0 ]; then
  printf 'commit-msg: missing Task: T-XXX trailer in the body.\n' >&2
  printf '  See agentic-development-playbook/templates/AGENTS.md:131-138.\n' >&2
  printf '  Bypass: git commit --no-verify\n' >&2
  exit 1
fi
if [ "$TRAILER_COUNT" -gt 1 ]; then
  printf 'commit-msg: multiple Task: T-XXX trailers found.\n' >&2
  exit 1
fi
exit 0
