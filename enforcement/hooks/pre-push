#!/bin/sh
# .lefthook/pre-push — replay the commit-msg check on pushed commits.
# Warnings only; does not block the push. The user has already committed
# the changes; refusing to push would be a worse outcome than a warning.
# Usage (from git): $1 = remote name, $2 = remote URL.
# The push refspec is read from stdin (one or more "local-ref local-sha remote-ref remote-sha" lines).
set -e
command -v git >/dev/null 2>&1 || { printf 'pre-push: git not in PATH.\n' >&2; exit 0; }
REMOTE="${1:-}"
URL="${2:-}"

# Branch with no upstream: no commits to check, exit 0.
if [ -z "$REMOTE" ]; then
  exit 0
fi

# Read the push refspec from stdin (lines of "<local-ref> <local-sha> <remote-ref> <remote-sha>").
# For each local-sha, check the commit message for a Task: T-XXX trailer in the body.
WARN=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "$LOCAL_SHA" ] && continue
  # On force-push, LOCAL_SHA may be all zeros; skip.
  case "$LOCAL_SHA" in 0000000000000000000000000000000000000000) continue ;; esac
  # No-op push (local == remote): no new commits to check.
  [ "$LOCAL_SHA" = "$REMOTE_SHA" ] && continue
  # Collect commit messages for this ref (cap at 100 to avoid runaway).
  git log --max-count=100 --format='%H%n%b' "$REMOTE_SHA..$LOCAL_SHA" 2>/dev/null | \
    awk -v sha="$LOCAL_SHA" '
      BEGIN { count = 0; in_body = 0 }
      /^[0-9a-f]{40}$/ { sha = $0; in_body = 0; next }
      in_body == 0 && /^[[:space:]]*$/ && NR > 1 { in_body = 1; next }
      in_body == 1 && /^Task: T-[0-9]{3}[[:space:]]*$/ { count++; in_body = 0 }
      END {
        if (count == 0) {
          print "pre-push: " sha ": missing Task: T-XXX trailer in body."
        }
      }
    ' && [ $? -eq 0 ] || true
  # Track whether any warning was printed
  git log --max-count=100 --format='%H%n%b' "$REMOTE_SHA..$LOCAL_SHA" 2>/dev/null | \
    awk -v sha="$LOCAL_SHA" '
      BEGIN { has_trailer = 0; in_body = 0 }
      /^[0-9a-f]{40}$/ { in_body = 0; next }
      in_body == 0 && /^[[:space:]]*$/ && NR > 1 { in_body = 1; next }
      in_body == 1 && /^Task: T-[0-9]{3}[[:space:]]*$/ { has_trailer = 1 }
      END { if (has_trailer == 0) exit 1 }
    ' >/dev/null 2>&1 || WARN=$((WARN+1))
done

if [ "$WARN" -gt 0 ]; then
  printf 'pre-push: %d commit(s) without Task: T-XXX trailer. Pushing anyway.\n' "$WARN" >&2
fi
exit 0
